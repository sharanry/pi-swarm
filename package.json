{
  "name": "pi-swarm",
  "version": "0.1.0",
  "description": "Project-scoped peer-to-peer messaging between running Pi sessions",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "agents", "swarm"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharanry/pi-swarm.git"
  },
  "homepage": "https://github.com/sharanry/pi-swarm#readme",
  "bugs": {
    "url": "https://github.com/sharanry/pi-swarm/issues"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^24.10.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
